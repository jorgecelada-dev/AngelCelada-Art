# --- Supabase ---
# Los encuentras en supabase.com > tu proyecto > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave secreta (Service Role) - NUNCA la expongas en el cliente, solo se usa en el servidor
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe ---
# Los encuentras en dashboard.stripe.com > Developers > API keys (usa las de modo TEST por ahora)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Se genera al crear el webhook (dashboard.stripe.com > Developers > Webhooks), o con `stripe listen`
STRIPE_WEBHOOK_SECRET=

# --- General ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Lista de emails autorizados para entrar al panel privado del artista.
# Ejemplo: ADMIN_ALLOWED_EMAILS=angelcelada@email.com,tuemail@email.com
ADMIN_ALLOWED_EMAILS=
